rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function mpath(w) { return /databases/$(database)/documents/members/$(w + '_' + request.auth.uid); }
    function isMember(w) { return signedIn() && exists(mpath(w)); }
    function role(w) { return get(mpath(w)).data.role; }
    function canWrite(w) { return isMember(w) && role(w) in ['owner', 'admin', 'editor']; }
    function canManage(w) { return isMember(w) && role(w) in ['owner', 'admin']; }
    function seesAll(w) { return isMember(w) && (role(w) in ['owner', 'admin'] || get(mpath(w)).data.see_all == true); }
    function unchanged(f) { return request.resource.data[f] == resource.data[f]; }
    function canChat(t) {
      let th = get(/databases/$(database)/documents/chat_threads/$(t)).data;
      return signedIn() && ((th.workspace_id != null && isMember(th.workspace_id)) || uid() in th.member_ids);
    }

    // ---------- people ----------
    match /users/{u} {
      allow get: if signedIn();
      allow create, update: if signedIn() && uid() == u;
      allow delete: if signedIn() && uid() == u;
    }
    match /usernames/{name} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == uid();
      allow delete: if signedIn() && resource.data.uid == uid();
    }
    match /emails/{email} {
      allow get: if signedIn();
      allow create, update: if signedIn() && request.resource.data.uid == uid();
      allow delete: if signedIn() && resource.data.uid == uid();
    }

    // ---------- workspaces & membership ----------
    match /workspaces/{w} {
      allow read: if isMember(w);
      allow create: if signedIn() && request.resource.data.created_by == uid();
      allow update: if canManage(w) && unchanged('created_by');
      allow delete: if signedIn() && isMember(w) && role(w) == 'owner';
    }
    match /members/{m} {
      allow get: if signedIn() && (resource == null || resource.data.user_id == uid() || isMember(resource.data.workspace_id));
      allow list: if signedIn() && (resource.data.user_id == uid() || isMember(resource.data.workspace_id));
      // the workspace creator becomes owner in the same batch that creates the workspace
      allow create: if signedIn() && request.resource.data.workspace_id is string && m == request.resource.data.workspace_id + '_' + request.resource.data.user_id && (
        (canManage(request.resource.data.workspace_id) && request.resource.data.role in ['admin', 'editor', 'viewer'])
        || (request.resource.data.role == 'owner' && request.resource.data.user_id == uid()
            && !exists(/databases/$(database)/documents/workspaces/$(request.resource.data.workspace_id))
            && getAfter(/databases/$(database)/documents/workspaces/$(request.resource.data.workspace_id)).data.created_by == uid()));
      allow update: if canManage(resource.data.workspace_id) && resource.data.role != 'owner'
        && request.resource.data.role in ['admin', 'editor', 'viewer'] && unchanged('workspace_id') && unchanged('user_id');
      allow delete: if signedIn() && ((canManage(resource.data.workspace_id) && resource.data.role != 'owner') || resource.data.user_id == uid());
    }

    // ---------- books ----------
    match /categories/{id} {
      allow read: if isMember(resource.data.workspace_id);
      allow create: if canManage(request.resource.data.workspace_id);
      allow update, delete: if canManage(resource.data.workspace_id);
    }
    match /items/{id} {
      allow read: if isMember(resource.data.workspace_id);
      allow create: if canManage(request.resource.data.workspace_id);
      allow update, delete: if canManage(resource.data.workspace_id);
    }
    match /people/{id} {
      allow read: if isMember(resource.data.workspace_id);
      allow create: if canWrite(request.resource.data.workspace_id);
      allow update, delete: if canManage(resource.data.workspace_id);
    }
    match /entries/{id} {
      allow read: if isMember(resource.data.workspace_id) && (seesAll(resource.data.workspace_id) || resource.data.created_by == uid());
      allow create: if canWrite(request.resource.data.workspace_id) && request.resource.data.created_by == uid()
        && request.resource.data.type in ['expense', 'income'] && request.resource.data.amount is number && request.resource.data.amount >= 0
        && (canManage(request.resource.data.workspace_id) || request.resource.data.claim_status in [null, 'submitted']);
      allow update: if unchanged('workspace_id') && request.resource.data.amount is number && request.resource.data.amount >= 0 && (
        canManage(resource.data.workspace_id)
        || (canWrite(resource.data.workspace_id) && resource.data.created_by == uid() && unchanged('created_by')
            && resource.data.claim_status in [null, 'submitted'] && request.resource.data.claim_status in [null, 'submitted']));
      allow delete: if canManage(resource.data.workspace_id)
        || (canWrite(resource.data.workspace_id) && resource.data.created_by == uid() && resource.data.claim_status in [null, 'submitted']);
    }
    match /entry_log/{id} {
      allow read: if canManage(resource.data.workspace_id);
      allow create: if canWrite(request.resource.data.workspace_id);
    }
    match /bank_transactions/{id} {
      allow read: if canManage(resource.data.workspace_id);
      allow create: if canManage(request.resource.data.workspace_id);
      allow update, delete: if canManage(resource.data.workspace_id);
    }

    // ---------- store ----------
    match /stores/{id} {
      allow read: if isMember(resource.data.workspace_id);
      allow create: if canManage(request.resource.data.workspace_id);
      allow update, delete: if canManage(resource.data.workspace_id);
    }
    match /store_items/{id} {
      allow read: if isMember(resource.data.workspace_id);
      allow create: if canManage(request.resource.data.workspace_id);
      // editors may change only the stock count (recorded together with a stock move); it can never go negative
      allow update: if canManage(resource.data.workspace_id)
        || (canWrite(resource.data.workspace_id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty']) && request.resource.data.qty is int && request.resource.data.qty >= 0);
      allow delete: if canManage(resource.data.workspace_id);
    }
    match /stock_moves/{id} {
      allow read: if isMember(resource.data.workspace_id);
      allow create: if canWrite(request.resource.data.workspace_id) && request.resource.data.created_by == uid()
        && request.resource.data.qty is int && request.resource.data.qty > 0 && request.resource.data.direction in ['in', 'out']
        && getAfter(/databases/$(database)/documents/store_items/$(request.resource.data.store_item_id)).data.qty
           == get(/databases/$(database)/documents/store_items/$(request.resource.data.store_item_id)).data.qty
              + (request.resource.data.direction == 'in' ? request.resource.data.qty : -request.resource.data.qty)
        && getAfter(/databases/$(database)/documents/store_items/$(request.resource.data.store_item_id)).data.qty >= 0;
      allow delete: if canManage(resource.data.workspace_id);
    }

    // ---------- chats ----------
    match /chat_threads/{t} {
      allow get: if signedIn() && (resource == null || (resource.data.workspace_id != null && isMember(resource.data.workspace_id)) || uid() in resource.data.member_ids);
      allow list: if signedIn() && ((resource.data.workspace_id != null && isMember(resource.data.workspace_id)) || uid() in resource.data.member_ids);
      allow create: if signedIn() && (
        (request.resource.data.kind == 'workspace' && t == 'ws_' + request.resource.data.workspace_id && isMember(request.resource.data.workspace_id))
        || (request.resource.data.kind in ['private', 'group'] && uid() in request.resource.data.member_ids));
    }
    match /chat_members/{id} {
      allow read: if signedIn() && (resource.data.user_id == uid() || canChat(resource.data.thread_id));
      allow create: if signedIn() && id == request.resource.data.thread_id + '_' + request.resource.data.user_id && canChat(request.resource.data.thread_id)
        && (request.resource.data.user_id == uid() || request.resource.data.user_id in get(/databases/$(database)/documents/chat_threads/$(request.resource.data.thread_id)).data.member_ids);
      allow update: if signedIn() && resource.data.user_id == uid();
      allow delete: if signedIn() && resource.data.user_id == uid();
    }
    match /chat_messages/{id} {
      allow read: if canChat(resource.data.thread_id);
      allow create: if canChat(request.resource.data.thread_id) && request.resource.data.sender_id == uid()
        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 4000;
    }

    // ---------- feedback inbox (read it in the Firebase console) ----------
    match /feedback/{id} {
      allow create: if signedIn() && request.resource.data.user_id == uid() && request.resource.data.body.size() <= 4000;
      allow read: if signedIn() && resource.data.user_id == uid();
    }
  }
}
