// LOCAL DEMO ONLY. The Storage emulator in some environments cannot evaluate firestore.get()/exists() cross-service lookups,
// so this variant checks sign-in, file type and size but NOT workspace membership. Production uses firebase/storage.rules.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{w}/{file} {
      allow read, delete: if request.auth != null;
      allow create: if request.auth != null && request.resource.size < 3 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }
  }
}
