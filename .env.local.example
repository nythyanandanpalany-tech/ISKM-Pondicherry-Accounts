# ExpenseFlow — environment template.
# Copy to .env.local for local development (`cp .env.local.example .env.local`), and enter the same
# values in Vercel under Project -> Settings -> Environment Variables for the deployed site.
#
# Only the three NEXT_PUBLIC_* values below are read by the app. Everything after them is either
# optional or a reminder of a setting that lives in a dashboard rather than in this file.
# NEXT_PUBLIC_ means the value is compiled into the browser bundle, so never put a secret in one.


# ===== Required: Supabase =====
# Supabase dashboard -> Project Settings -> API

# The project's API URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# The project's low-privilege client key, from Project Settings -> API Keys.
#
# Take the PUBLISHABLE key (sb_publishable_...) from the "Publishable and secret API keys" tab.
# The "Legacy" tab's `anon` key (a JWT starting with eyJ...) also works and is what older guides
# describe, but Supabase is retiring it at the end of 2026. Both have identical privileges, and
# createClient accepts either, so there is no reason to start on the legacy one.
#
# Whichever you use belongs in the browser: row level security in supabase/schema.sql decides what
# each signed-in person may read and write. Never put the secret key (sb_secret_...) or the legacy
# service_role key here — they bypass every policy. This app never needs either.
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ===== Required: app behaviour =====

# When true, the ledger (entries/categories/items/people) shows a few built-in sample records
# instead of your real data — handy for demos and screenshots. Writes to those tables are
# blocked while this is on, so it can never overwrite real data. Set to false for real data.
NEXT_PUBLIC_SEED_DUMMY_DATA=false


# ===== Optional: the daily keep-alive ping =====
# A free Supabase project is paused after about a week of inactivity, so Vercel Cron calls
# /api/keepalive once a day (see vercel.json). Set a long random string here and Vercel will send
# it as a Bearer token, and the route will refuse anyone else. Leave it unset and the route stays
# open to the public — harmless, since it returns no data, but it can be called by anyone.
# Generate one with:  openssl rand -hex 32
# Set it in Vercel too, or the cron job will start getting 401s.
# CRON_SECRET=


# ===== Not read by this app: sign-in email (Supabase dashboard) =====
# Supabase sends the confirmation and magic-link emails, so these are entered in the dashboard
# under Authentication -> Emails -> SMTP Settings, not here. Noted so the whole setup is in one
# place. For Gmail you need an App password (Google Account -> Security -> App passwords); the
# account's normal password will not work, and 2-Step Verification must be on first.
#   Host        smtp.gmail.com
#   Port        465
#   Username    the full Gmail address
#   Password    the 16-character App password
#   Sender      the same Gmail address, e.g. name "ISKM Pondicherry Accounts"
# Also set Authentication -> URL Configuration -> Site URL to the deployed address, and add
# https://<your-app>.vercel.app/** and http://localhost:3000/** as Redirect URLs, or sign-in
# links will fail.


# ===== Not read by this app: running the policy tests =====
# `npm run test:rls` talks to a local PostgreSQL through the standard PG* variables, e.g.
#   PGHOST=127.0.0.1 PGPORT=5432 PGUSER=postgres npm run test:rls
# EF_TEST_DB overrides the throwaway database name (default ef_rls_test). It is dropped and
# recreated on every run, so never point it at a database you care about.
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=postgres
# EF_TEST_DB=ef_rls_test
